{
  "expo": {
    "name": "Chertilla",
    "slug": "chertilla",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chertilla",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.chertilla.app"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      [
        "expo-gradle-jvmargs",
        {
          "xmx": "4g",
          "maxMetaspace": "1g",
          "extraArgs": [
            "-Dkotlin.daemon.jvm.options=-Xmx2g",
            "-Dfile.encoding=UTF-8"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "TELEGRAM_BOT_TOKEN": "9256001618:AAEC-_-npoiMkVZCoXs2LnDHk7IbOdEtNBcы",
      "TELEGRAM_CHAT_ID": "1241726180",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d7f43d65-aa25-44fb-b36f-0bf9656cd222"
      }
    },
    "owner": "kamizzzh"
  }
}